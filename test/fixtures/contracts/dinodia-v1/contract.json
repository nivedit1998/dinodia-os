{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dinodiasmartliving.com/contracts/dinodia-v1/contract.json",
  "contractVersion": "dinodia.v1",
  "wireRules": {
    "ids": "opaque non-empty strings; UUID format is not part of the public contract",
    "timestamps": "RFC3339 UTC timestamps; all freshness comparisons use server time",
    "unknownFields": "reject security/authority objects; ignore only documented extension maps",
    "managementClass": ["property_device", "tenant_device"],
    "freshness": {
      "heartbeatExpectedSeconds": 120,
      "onlineThroughSeconds": 420,
      "stateValidity": "descriptor.expectedReportIntervalSeconds; then quality=unknown"
    },
    "customerAppName": "Dinodia Smart Living",
    "authority": "homeId + homeMembershipId; role is membership-scoped; employee identity is never a household role"
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "timestamp": { "type": "string", "format": "date-time" },
    "role": { "enum": ["OWNER", "PROPERTY_MANAGER", "TENANT"] },
    "managementClass": { "enum": ["property_device", "tenant_device"] },
    "quality": { "enum": ["fresh", "stale", "unknown", "unavailable"] },
    "envelope": {
      "type": "object",
      "required": [
        "schemaVersion",
        "homeId",
        "streamId",
        "sequence",
        "generatedAt",
        "revision",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "dinodia.v1" },
        "homeId": { "$ref": "#/$defs/id" },
        "streamId": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 0 },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "revision": { "type": "integer", "minimum": 0 },
        "data": {}
      },
      "additionalProperties": false
    },
    "area": {
      "type": "object",
      "required": ["id", "homeId", "originalName", "revision", "lifecycle"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "homeId": { "$ref": "#/$defs/id" },
        "originalName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "overrideName": { "type": ["string", "null"], "maxLength": 80 },
        "revision": { "type": "integer", "minimum": 0 },
        "lifecycle": { "enum": ["active", "retired"] }
      },
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "required": [
        "schemaVersion",
        "deviceId",
        "controlId",
        "label",
        "valueType",
        "interactionKind",
        "semanticRole",
        "readable",
        "writable",
        "automatable",
        "observable",
        "idempotency",
        "confirmationPolicy",
        "riskLevel",
        "stepUpPolicy",
        "sortOrder",
        "catalogRevision"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "deviceId": { "$ref": "#/$defs/id" },
        "surfaceId": { "type": ["string", "null"] },
        "controlId": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "group": { "type": ["string", "null"], "maxLength": 80 },
        "sortOrder": { "type": "integer", "minimum": 0 },
        "valueType": {
          "enum": ["boolean", "number", "option", "text", "invoke"]
        },
        "interactionKind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "semanticRole": {
          "enum": [
            "power",
            "brightness",
            "active_heat_demand",
            "active_heat_production",
            "target_temperature",
            "ambient_temperature",
            "opening_percentage",
            "connectivity",
            "security_lock",
            "lock_state",
            "operating_mode",
            "position",
            "volume",
            "color",
            "state",
            "unknown"
          ]
        },
        "readable": { "type": "boolean" },
        "writable": { "type": "boolean" },
        "automatable": { "type": "boolean" },
        "observable": { "type": "boolean" },
        "idempotency": { "enum": ["set_value", "invoke_once", "none"] },
        "confirmationPolicy": {
          "enum": ["none", "matching_observation", "explicit_user", "step_up"]
        },
        "riskLevel": { "enum": ["low", "normal", "sensitive", "critical"] },
        "stepUpPolicy": { "enum": ["none", "required"] },
        "constraints": {
          "type": "object",
          "properties": {
            "minimum": { "type": "number" },
            "maximum": { "type": "number" },
            "step": { "type": "number", "exclusiveMinimum": 0 },
            "precision": { "type": "integer", "minimum": 0, "maximum": 12 },
            "unit": { "type": "string", "maxLength": 32 },
            "options": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "required": ["value", "label"],
                "properties": {
                  "value": {},
                  "label": { "type": "string", "maxLength": 80 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "expectedReportingIntervalSeconds": { "type": "integer", "minimum": 1 },
        "maxStateValiditySeconds": { "type": "integer", "minimum": 1 },
        "unsupportedReason": { "type": ["string", "null"], "maxLength": 120 },
        "catalogRevision": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "writable": { "const": true } }, "required": ["writable"] },
          "then": { "properties": { "readable": { "const": true } } }
        },
        {
          "if": { "properties": { "interactionKind": { "not": { "enum": ["toggle", "slider", "thermostat", "picker", "text_input", "momentary_action", "read_only"] } } }, "required": ["interactionKind"] },
          "then": { "properties": { "readable": { "const": true }, "writable": { "const": false }, "automatable": { "const": false }, "idempotency": { "const": "none" }, "confirmationPolicy": { "const": "none" }, "stepUpPolicy": { "const": "none" } } }
        },
        {
          "if": { "properties": { "semanticRole": { "enum": ["security_lock", "lock_state"] } }, "required": ["semanticRole"] },
          "then": { "properties": { "stepUpPolicy": { "const": "required" }, "automatable": { "const": false } } }
        },
        {
          "if": { "properties": { "stepUpPolicy": { "const": "required" } }, "required": ["stepUpPolicy"] },
          "then": { "properties": { "automatable": { "const": false } } }
        },
        {
          "if": { "properties": { "valueType": { "const": "option" }, "writable": { "const": true } }, "required": ["valueType", "writable"] },
          "then": { "required": ["constraints"], "properties": { "constraints": { "required": ["options"], "properties": { "options": { "minItems": 1 } } } } }
        }
      ],
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "required": [
        "id",
        "homeId",
        "managementClass",
        "lifecycle",
        "technicalLabel",
        "controls",
        "descriptorRevision"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "homeId": { "$ref": "#/$defs/id" },
        "managementClass": { "$ref": "#/$defs/managementClass" },
        "ownerMembershipId": { "type": ["string", "null"] },
        "lifecycle": {
          "enum": ["commissioning", "installed", "view_only", "retired"]
        },
        "technicalLabel": { "type": "string", "maxLength": 80 },
        "customerLabel": { "type": ["string", "null"], "maxLength": 40 },
        "areaIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "controls": {
          "type": "array",
          "items": { "$ref": "#/$defs/control" },
          "maxItems": 64
        },
        "descriptorRevision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "controlState": {
      "type": "object",
      "required": [
        "deviceId",
        "controlId",
        "homeId",
        "descriptorRevision",
        "revision",
        "observedAt",
        "receivedAt",
        "quality",
        "value",
        "validUntil",
        "deviceAvailability",
        "analyticsActivity"
      ],
      "properties": {
        "deviceId": { "$ref": "#/$defs/id" },
        "controlId": { "$ref": "#/$defs/id" },
        "homeId": { "$ref": "#/$defs/id" },
        "descriptorRevision": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 0 },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "receivedAt": { "$ref": "#/$defs/timestamp" },
        "quality": { "$ref": "#/$defs/quality" },
        "value": {},
        "validUntil": { "$ref": "#/$defs/timestamp" },
        "deviceAvailability": { "enum": ["online", "offline", "unknown"] },
        "analyticsActivity": { "enum": ["on", "off", "unknown"] }
      },
      "additionalProperties": false
    },
    "membership": {
      "type": "object",
      "required": [
        "accountId",
        "homeId",
        "homeMembershipId",
        "role",
        "status",
        "areaIds",
        "revision"
      ],
      "properties": {
        "accountId": { "$ref": "#/$defs/id" },
        "homeId": { "$ref": "#/$defs/id" },
        "homeMembershipId": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/role" },
        "status": { "enum": ["active", "suspended", "removed"] },
        "areaIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "revision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "accountSessionContext": {
      "type": "object",
      "required": ["schemaVersion", "accountId", "memberships", "expiresAt"],
      "properties": {
        "schemaVersion": { "const": "dinodia.v1" },
        "accountId": { "$ref": "#/$defs/id" },
        "memberships": { "type": "array", "items": { "$ref": "#/$defs/membership" }, "uniqueItems": true },
        "expiresAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "customerSessionLoginRequest": {
      "type": "object",
      "required": ["email", "password", "deviceInstallationId", "publicKey", "deviceName"],
      "properties": {
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 320 },
        "password": { "type": "string", "minLength": 1, "maxLength": 1024, "writeOnly": true },
        "deviceInstallationId": { "$ref": "#/$defs/id" },
        "publicKey": { "type": "string", "minLength": 1, "maxLength": 4096, "writeOnly": true },
        "deviceName": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
        "model": { "type": "string", "maxLength": 160 },
        "osFamily": { "type": "string", "maxLength": 80 },
        "osVersion": { "type": "string", "maxLength": 80 }
      },
      "additionalProperties": false
    },
    "customerSessionReceipt": {
      "type": "object",
      "required": ["ok", "accountId", "sessionId", "trustedDeviceId", "expiresAt"],
      "properties": {
        "ok": { "const": true },
        "accountId": { "$ref": "#/$defs/id" },
        "sessionId": { "$ref": "#/$defs/id" },
        "trustedDeviceId": { "$ref": "#/$defs/id" },
        "expiresAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "customerSessionLogoutReceipt": {
      "type": "object",
      "required": ["ok"],
      "properties": { "ok": { "const": true } },
      "additionalProperties": false
    },
    "customerHubSession": {
      "type": "object",
      "required": ["ok", "token", "expiresAt", "homeId", "membershipId", "hubEndpoint"],
      "properties": {
        "ok": { "const": true },
        "token": { "type": "string", "minLength": 1, "maxLength": 8192, "description": "Short-lived bearer. Native client memory only; never persist, log, render or forward to an unverified hub origin." },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "homeId": { "$ref": "#/$defs/id" },
        "membershipId": { "$ref": "#/$defs/id" },
        "hubEndpoint": {
          "type": "object",
          "oneOf": [
            {
              "required": ["state", "origin"],
              "properties": {
                "state": { "const": "verified_cloud" },
                "origin": { "type": "string", "pattern": "^https://dinodia-[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.dinodiasmartliving\\.com$" }
              },
              "additionalProperties": false
            },
            {
              "required": ["state"],
              "properties": { "state": { "const": "unavailable" } },
              "not": { "required": ["origin"] },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "offlineHomeCandidate": {
      "type": "object",
      "required": ["schemaVersion", "grantId", "accountId", "homeId", "homeMembershipId", "trustedDeviceId", "role", "areaIds", "membershipRevision", "issuedAt", "expiresAt"],
      "properties": {
        "schemaVersion": { "const": "dinodia.v1" },
        "grantId": { "$ref": "#/$defs/id" },
        "accountId": { "$ref": "#/$defs/id" },
        "homeId": { "$ref": "#/$defs/id" },
        "homeMembershipId": { "$ref": "#/$defs/id" },
        "trustedDeviceId": { "$ref": "#/$defs/id" },
        "role": { "const": "TENANT" },
        "areaIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "membershipRevision": { "type": "integer", "minimum": 0 },
        "issuedAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "offlineHomeSelection": {
      "type": "object",
      "required": ["schemaVersion", "accountId", "generatedAt", "state", "candidates"],
      "properties": {
        "schemaVersion": { "const": "dinodia.v1" },
        "accountId": { "$ref": "#/$defs/id" },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "state": { "const": "offline" },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/offlineHomeCandidate" } }
      },
      "additionalProperties": false
    },
    "accessPolicy": {
      "type": "object",
      "required": ["homeId", "homeMembershipId", "role", "scopes", "revision"],
      "properties": {
        "homeId": { "$ref": "#/$defs/id" },
        "homeMembershipId": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/role" },
        "scopes": {
          "type": "array",
          "items": { "type": "string", "maxLength": 100 },
          "uniqueItems": true
        },
        "areaIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "revision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": [
        "commandId",
        "homeId",
        "homeMembershipId",
        "deviceId",
        "controlId",
        "descriptorRevision",
        "value",
        "issuedAt",
        "idempotencyKey"
      ],
      "properties": {
        "commandId": { "$ref": "#/$defs/id" },
        "homeId": { "$ref": "#/$defs/id" },
        "homeMembershipId": { "$ref": "#/$defs/id" },
        "deviceId": { "$ref": "#/$defs/id" },
        "controlId": { "$ref": "#/$defs/id" },
        "descriptorRevision": { "type": "integer", "minimum": 0 },
        "value": {},
        "issuedAt": { "$ref": "#/$defs/timestamp" },
        "idempotencyKey": {
          "type": "string",
          "minLength": 16,
          "maxLength": 160
        },
        "stepUpOperationId": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "commandResult": {
      "type": "object",
      "required": ["commandId", "homeId", "status", "acceptedAt"],
      "properties": {
        "commandId": { "$ref": "#/$defs/id" },
        "homeId": { "$ref": "#/$defs/id" },
        "status": {
          "enum": ["accepted", "succeeded", "rejected", "uncertain", "expired"]
        },
        "acceptedAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "errorCode": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "analyticsObservation": {
      "type": "object",
      "required": [
        "homeId",
        "deviceId",
        "category",
        "observedAt",
        "validUntil",
        "activity",
        "quality"
      ],
      "properties": {
        "homeId": { "$ref": "#/$defs/id" },
        "deviceId": { "$ref": "#/$defs/id" },
        "category": { "enum": ["light", "radiator", "boiler", "none"] },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "validUntil": { "$ref": "#/$defs/timestamp" },
        "activity": { "enum": ["on", "off", "unknown"] },
        "quality": { "$ref": "#/$defs/quality" },
        "temperatureCelsius": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "alexaDiscoveryProjection": {
      "type": "object",
      "required": [
        "schemaVersion",
        "homeId",
        "membership",
        "selectedAreaIds",
        "exposureGeneration",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "dinodia.v1" },
        "homeId": { "$ref": "#/$defs/id" },
        "membership": {
          "type": "object",
          "required": ["homeMembershipId", "role"],
          "properties": {
            "homeMembershipId": { "$ref": "#/$defs/id" },
            "role": { "const": "TENANT" }
          },
          "additionalProperties": false
        },
        "selectedAreaIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "exposureGeneration": { "type": "integer", "minimum": 0 },
        "data": { "type": "array", "items": { "$ref": "#/$defs/device" } }
      },
      "additionalProperties": false
    },
    "controlCatalog": {
      "type": "object",
      "required": [
        "schemaVersion",
        "homeId",
        "deviceId",
        "catalogRevision",
        "controls"
      ],
      "properties": {
        "schemaVersion": { "const": "dinodia.v1" },
        "homeId": { "$ref": "#/$defs/id" },
        "deviceId": { "$ref": "#/$defs/id" },
        "catalogRevision": { "type": "integer", "minimum": 0 },
        "controls": {
          "type": "array",
          "items": { "$ref": "#/$defs/control" },
          "maxItems": 64
        },
        "deletedControlIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "controlCatalogEvent": {
      "type": "object",
      "required": [
        "schemaVersion",
        "homeId",
        "streamId",
        "sequence",
        "generatedAt",
        "revision",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "dinodia.v1" },
        "homeId": { "$ref": "#/$defs/id" },
        "streamId": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 0 },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "revision": { "type": "integer", "minimum": 0 },
        "data": { "$ref": "#/$defs/controlCatalog" }
      },
      "additionalProperties": false
    },
    "stateEvent": {
      "type": "object",
      "required": [
        "schemaVersion",
        "homeId",
        "streamId",
        "sequence",
        "generatedAt",
        "revision",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "dinodia.v1" },
        "homeId": { "$ref": "#/$defs/id" },
        "streamId": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 0 },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "revision": { "type": "integer", "minimum": 0 },
        "data": { "$ref": "#/$defs/controlState" }
      },
      "additionalProperties": false
    },
    "override": {
      "type": "object",
      "required": [
        "homeId",
        "targetId",
        "targetType",
        "field",
        "value",
        "revision"
      ],
      "properties": {
        "homeId": { "$ref": "#/$defs/id" },
        "targetId": { "$ref": "#/$defs/id" },
        "targetType": { "enum": ["area", "device"] },
        "field": { "enum": ["overrideName", "customerLabel"] },
        "value": { "type": ["string", "null"], "maxLength": 80 },
        "revision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "automation": {
      "type": "object",
      "required": [
        "id",
        "homeId",
        "revision",
        "name",
        "enabled",
        "trigger",
        "actions",
        "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "homeId": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "enabled": { "type": "boolean" },
        "trigger": {
          "type": "object",
          "required": ["kind", "schedule"],
          "properties": {
            "kind": { "const": "schedule" },
            "schedule": { "type": "object" }
          },
          "additionalProperties": false
        },
        "actions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "deviceId",
              "controlId",
              "descriptorRevision",
              "value"
            ],
            "properties": {
              "deviceId": { "$ref": "#/$defs/id" },
              "controlId": { "$ref": "#/$defs/id" },
              "descriptorRevision": { "type": "integer", "minimum": 0 },
              "value": {}
            },
            "additionalProperties": false
          }
        },
        "status": {
          "enum": ["active", "disabled", "needs_attention", "deleted"]
        }
      },
      "additionalProperties": false
    },
    "automationPropertyImpactProjection": {
      "type": "object",
      "required": ["schemaVersion", "homeId", "membershipId", "role", "revision", "automations"],
      "properties": {
        "schemaVersion": { "const": "dinodia.v1" },
        "homeId": { "$ref": "#/$defs/id" },
        "membershipId": { "$ref": "#/$defs/id" },
        "role": { "enum": ["OWNER", "PROPERTY_MANAGER"] },
        "revision": { "type": "integer", "minimum": 0 },
        "automations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["automationId", "tenantName", "name", "schedule", "affectedPermanentDevices", "availableActions", "stepUpRequired"],
            "properties": {
              "automationId": { "$ref": "#/$defs/id" },
              "tenantName": { "type": "string", "minLength": 1, "maxLength": 80 },
              "name": { "type": "string", "minLength": 1, "maxLength": 60 },
              "schedule": {
                "type": "object",
                "required": ["timezone", "daysOfWeek", "localTime"],
                "properties": {
                  "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "daysOfWeek": { "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 7 } },
                  "localTime": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" }
                },
                "additionalProperties": false
              },
              "affectedPermanentDevices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["deviceId", "displayName"],
