    { "id": "reject-then-resubmit-immediately", "emailVerified": true, "activeOwnerExists": true, "previousState": "REJECTED", "elapsedSeconds": 0, "expected": "NEW_REQUEST_ALLOWED", "cooldownSeconds": 0 },
    { "id": "exact-seven-day-expiry", "emailVerified": true, "activeOwnerExists": true, "elapsedSeconds": 604800, "expected": "REQUEST_EXPIRED", "membershipCreated": false },
    { "id": "ownerless-request-persists-nothing", "emailVerified": true, "activeOwnerExists": false, "expected": "NO_DURABLE_REQUEST", "persistedRequest": false, "membershipCreated": false },
