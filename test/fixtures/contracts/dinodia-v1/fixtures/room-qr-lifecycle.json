    { "id": "verified-request-exact-area", "emailVerified": true, "activeOwnerExists": true, "requestedAreaId": "area:room-a", "expected": "PENDING_OWNER_DECISION", "ownerVisible": true, "grantedAreaIds": [], "membershipCreated": false },
    { "id": "latest-valid-request-replaces-older-pending", "emailVerified": true, "activeOwnerExists": true, "previousState": "PENDING", "expected": "PENDING_OWNER_DECISION", "olderPendingVisible": false, "latestPendingVisible": true, "membershipCreated": false },
