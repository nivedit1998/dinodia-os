NODE_ENV=production
DINODIA_HA_PORT=8123
DINODIA_HUB_AGENT_PORT=8099
DINODIA_HA_HOST=0.0.0.0
DINODIA_DATA_DIR=/data
# Production native access is established through Company Portal sessions.
# Do not add dashboard passwords, HA tokens or bootstrap secrets here.

# Local MQTT broker and Zigbee2MQTT
MQTT_URL=
ZIGBEE2MQTT_BASE_TOPIC=zigbee2mqtt
ZIGBEE2MQTT_DISCOVERY_PREFIX=dinodia-ha
DINODIA_ZIGBEE_PAIRING_SECONDS=120
DINODIA_ZIGBEE_EVENT_DEDUPE_MS=1500
DINODIA_ZIGBEE_AUTO_RESTART=true
DINODIA_COMPOSE_FILE=/opt/dinodia-os/docker-compose.yml
DINODIA_ENV_FILE=/opt/dinodia-os/.env
# The dashboard writes the selected stable /dev/serial/by-id path into
# data/zigbee2mqtt/configuration.yaml. These are only legacy overrides.
ZIGBEE_ADAPTER_PATH=
ZIGBEE_SERIAL_PORT=

# Matter Server WebSocket API (optional until Matter hardware is installed)
MATTER_SERVER_URL=
DINODIA_MATTER_PAIRING_TTL_MS=300000

# OTBR health endpoint (optional; OTBR normally runs with host networking)
OTBR_URL=
THREAD_RCP_DEVICE=
THREAD_RCP_BAUDRATE=460800
OT_RCP_DEVICE=spinel+hdlc+uart:///dev/ttyACM0?uart-baudrate=460800
OT_INFRA_IF=eth0
OT_THREAD_IF=wpan0

# Optional Cloudflare Tunnel token
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_PUBLIC_HOSTNAME=

# Dinodia platform pairing and token-state sync
DINODIA_PLATFORM_API_URL=
DINODIA_PLATFORM_SYNC_INTERVAL_MS=120000
DINODIA_HEARTBEAT_INTERVAL_MS=120000
DINODIA_APP_PUBLIC_KEYS=
DINODIA_OPERATOR_PUBLIC_KEY=
DINODIA_MANUFACTURING_ROOT_PUBLIC_KEYS=
DINODIA_IDENTITY_BROKER_SOCKET=/run/dinodia-identityd.sock
DINODIA_STATE_CHANGE_URL=
DINODIA_STATE_CHANGE_SECRET=

# Hive cloud account integration (credentials are entered in the dashboard and
# stored only in the encrypted local vault; never place them in this file).
DINODIA_HIVE_ENABLED=true
DINODIA_HIVE_PYTHON_PATH=/opt/dinodia-os/.venv-hive/bin/python
DINODIA_HIVE_WORKER_PATH=/opt/dinodia-os/src/integrations/hive/python/hive_worker.py
DINODIA_HIVE_POLL_INTERVAL_MS=120000
DINODIA_HIVE_OPERATION_TIMEOUT_MS=12000
DINODIA_HIVE_SETUP_TTL_MS=600000
DINODIA_HIVE_CLIENT_NAME=Dinodia OS
DINODIA_HIVE_ALLOW_INSECURE_SETUP=false
DINODIA_GOOGLE_NEST_ENABLED=true
DINODIA_GOOGLE_NEST_RELEASE_CHANNEL=sandbox_beta
DINODIA_GOOGLE_NEST_POLL_INTERVAL_MS=60000
DINODIA_GOOGLE_NEST_OPERATION_TIMEOUT_MS=12000
DINODIA_GOOGLE_NEST_SETUP_TTL_MS=600000
DINODIA_GOOGLE_NEST_REFRESH_SKEW_MS=300000
DINODIA_GOOGLE_NEST_MAX_DEVICES=100

DINODIA_HUB_ID=
DINODIA_DEVELOPER_MODE=false
